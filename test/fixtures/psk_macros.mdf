//
// Macro # 33
/$ 32 Feld Hell
<MODEM:FELDHELL>\n
<RIGMODE:USB-D>\n
<MACROS:/Users/brian/.fldigi/macros/hell_macros.mdf>\n
<RXRSID:off>\n
<TXRSID:off>

//
// Macro # 34
/$ 33 Olivia 8-250
<MODEM:OLIVIA:250:8>\n
<RIGMODE:USB-D>\n
<MACROS:/Users/brian/.fldigi/macros/olivia_macros.mdf>\n
<RXRSID:on>\n
<TXRSID:on>

//
// Macro # 35
/$ 34 PSK
<MODEM:BPSK31>\n
<RIGMODE:USB-D>\n
<MACROS:/Users/brian/.fldigi/macros/psk_macros.mdf>\n
<RXRSID:off>\n
<TXRSID:off>

//
// Macro # 36
/$ 35 RTTY
<MODEM:RTTY>\n
<RIGMODE:USB-D>\n
<MACROS:/Users/brian/.fldigi/macros/rtty_macros.mdf>\n
