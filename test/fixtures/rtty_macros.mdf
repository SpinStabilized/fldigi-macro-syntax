//
// Macro # 44
/$ 43 Entry To QRZ
<EXEC>/opt/homebrew/bin/uv run --directory $HOME/source/fldigi_to_qrz/ python fldigi_to_qrz.py</EXEC>

//
// Macro # 45
/$ 44 env
<EXEC>env | grep FLDIGI</EXEC>

