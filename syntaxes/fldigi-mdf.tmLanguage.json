{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "fldigi Macro",
  "scopeName": "source.mdf",
  "patterns": [
    { "include": "#comments" },
    { "include": "#fileHeader" },
    { "include": "#macroDefinition" },
    { "include": "#tags" },
    { "include": "#escapes" }
  ],
  "repository": {
    "fileHeader": {
      "name": "markup.bold.header.mdf",
      "match": "^//fldigi macro definition file extended$"
    },
    "comments": {
      "name": "comment.line.double-slash.mdf",
      "match": "//.*$"
    },
    "macroDefinition": {
      "name": "meta.macro.header.mdf",
      "match": "^(/\\$)\\s+(\\d+)\\s+(.*)$",
      "captures": {
        "1": { "name": "keyword.control.macro.mdf" },
        "2": { "name": "constant.numeric.macro-index.mdf" },
        "3": { "name": "entity.name.function.macro-label.mdf" }
      }
    },
    "tags": {
      "patterns": [
        {
          "name": "meta.tag.paired.mdf",
          "begin": "(<)(EXEC|VIDEO)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.mdf" },
            "2": { "name": "entity.name.tag.mdf" },
            "3": { "name": "punctuation.definition.tag.end.mdf" }
          },
          "end": "(</)(\\2)(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.mdf" },
            "2": { "name": "entity.name.tag.mdf" },
            "3": { "name": "punctuation.definition.tag.end.mdf" }
          },
          "contentName": "string.unquoted.path.mdf"
        },
        {
          "name": "meta.tag.with-args.mdf",
          "match": "(<)([A-Z0-9]+)(:)([^>]+)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.mdf" },
            "2": { "name": "entity.name.tag.mdf" },
            "3": { "name": "punctuation.separator.key-value.mdf" },
            "4": { "name": "variable.parameter.mdf" },
            "5": { "name": "punctuation.definition.tag.end.mdf" }
          }
        },
        {
          "name": "entity.name.tag.variable.mdf",
          "match": "<(MYCALL|CALL|RST|MYNAME|MYQTH|MYLOC|MYST|WX|TX_PWR|BAND|MODE|ZDT|NAME|ANTENNA|VER|INFO1|INFO2|MYRST|CNTR)>"
        },
        {
          "name": "entity.name.tag.command.mdf",
          "match": "<(TX|RX|LOG|TX/RX|CLRTX|CLRRX|INCR|DECR|IDLE|TIMER|RXRSID|TXRSID|MODEM|ID|XBEG|XEND)>"
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.mdf",
      "match": "\\\\n"
    }
  }
}